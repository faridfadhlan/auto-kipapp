# Konfigurasi Google Drive untuk Upload Otomatis Bukti Dukung (KIPApp BPS)

# Opsi 1: Google Service Account (Paling Mudah & Tanpa Pop-up Browser)
# Taruh file JSON Service Account di folder project sebagai 'service_account.json'
# atau tentukan lokasinya di sini:
GDRIVE_SERVICE_ACCOUNT_FILE=service_account.json
# GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# Opsi 2: Google OAuth 2.0 Client (Desktop App)
# Taruh file credentials.json di folder project sebagai 'credentials.json'
# GDRIVE_OAUTH_CLIENT_FILE=credentials.json

# ID Folder Google Drive Tujuan (Opsional)
# Salin ID dari URL folder Google Drive Anda:
# Contoh URL: https://drive.google.com/drive/folders/1aBcDeFgHiJkLmNoPqRsTuVwXyZ -> ID: 1aBcDeFgHiJkLmNoPqRsTuVwXyZ
GDRIVE_FOLDER_ID=
